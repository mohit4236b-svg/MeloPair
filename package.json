{
  "name": "echo-ambient-player",
  "version": "1.0.2",
  "description": "MeloPair music player with shared listening rooms, real-time sync, and synced lyrics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "test": "node tests/e2e/runner.js",
    "test:tier1": "node tests/e2e/runner.js --tier=1",
    "test:tier2": "node tests/e2e/runner.js --tier=2",
    "test:tier3": "node tests/e2e/runner.js --tier=3",
    "test:tier4": "node tests/e2e/runner.js --tier=4"
  },
  "build": {
    "appId": "com.echo.ambientplayer",
    "productName": "MeloPair",
    "directories": {
      "output": "build_out_public_release"
    },
    "compression": "normal",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "portable": {
      "useZip": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MeloPair-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "cloudflared.exe",
        "to": "bin/cloudflared.exe"
      },
      {
        "from": "yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      },
      {
        "from": "build_support/vc-runtime/vcruntime140.dll",
        "to": "bin/vcruntime140.dll"
      },
      {
        "from": "build_support/vc-runtime/msvcp140.dll",
        "to": "bin/msvcp140.dll"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "licenses/ffmpeg/LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "licenses/ffmpeg/BUILD-INFO.txt"
      },
      {
        "from": "node_modules/ffprobe-static/LICENSE",
        "to": "licenses/ffprobe/LICENSE.txt"
      },
      {
        "from": "node_modules/ffprobe-static/README.md",
        "to": "licenses/ffprobe/BUILD-INFO.txt"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "emojiMapper.js",
      "app.js",
      "echo-api-bridge.js",
      "icon.png",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon.svg",
      "assets/**/*",
      "default-art.png",
      "satellite.html",
      "jsQR.js",
      "crypto-js.js",
      "firebase-hosting/firebase-config.json",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/ffmpeg.exe",
      "!node_modules/ffprobe-static/bin/**",
      "!**/user-data*.json",
      "!**/echo_user_data.json",
      "!**/firebase-session.enc",
      "!**/firebase-pending-login.enc",
      "!**/hasInitializedFreshProfile.json",
      "!**/Local Storage/**",
      "!**/clean-smoke*/**"
    ]
  },
  "keywords": [
    "music",
    "visualizer",
    "beat-sync",
    "lyrics",
    "ambient"
  ],
  "author": "Echo Audio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "jsqr": "^1.4.0",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  }
}
